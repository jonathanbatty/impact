capture program drop impa
*! version 0.01 20 Sep 2024
program define impa
	version 17
	
	syntax ,   							  /// 
		   dataset(string)                /// Specifies the path to the dataset to be searched
	       id(string)                     /// Specifies the unique identifier in the dataset
		   codesystems(string)            /// Specifies the coding system(s) to be used in the mapping
		   searchvars(string)			  /// Variables to search for iMPA codes (same order as codesystems)
	       [                              ///
		      n_cores(integer 1)          /// Specify number of cores with which to run the mapping algorithm
			  summary                     /// Provides a summary of the totals of each codelist searched for
		   ] 

	// Set system parameters
	// Set niceness = 10 to free up memory immediately
	quietly set niceness 10
	
	// Set mata properties to favour speed
	mata: mata set matafavor speed
	mata: mata set matamofirst on
	
	// Check n_cores < number of available processors (regardless of Stata license)
	if (`n_cores' > `c(processors)') {
		noisily display as error "Warning: number of cores is set to more than those available on this machine."
		noisily display as error "Recommended maximum number of cores = number available - 1."
		noisily display as error "In this case, this will be: " `c(processors)' " - 1 = " `= c(processors) - 1' " cores."
		error 498
	}
	
	// Check if data is currently loaded into Stata
	capture assert _N == 0
	if _rc != 0 {
		noisily display as error "Please {stata clear all:clear all} data from Stata before running codefinder."
		error 498
	}
		   
	// Import mata functions 
	// Compile those that are required by workers to local .mo files (which the 
	// workers can then directly access)
	quietly findfile "impa.mata"
	run "`r(fn)'"
	quietly mata: mata mosave impa_load(), replace
	quietly mata: mata mosave impa_find(), replace
	
	// Import list of LTCs
	quietly findfile "__ltcs.ado"
	quietly include "`r(fn)'"
	
	// Initiate lookup array to store code-LTC mapping(s)
	mata: code_lookup = asarray_create()
	mata: asarray_notfound(code_lookup, "")	   
		   
	// Parse codesystems to identify which definition files to load
	local codesystems = strtrim("`codesystems'"))
	local num_codesystems : word count `codesystems'
	tokenize "`codesystems'", parse(",")
	
	// Parse searchvars to identify variables to search
	local searchvars = strtrim("`searchvars'")
	local num_searchvars : word count `searchvars'
	tokenize "`searchvars'", parse(",")
	
	// Combine all vars listed in searchvars
	local allvars = ""
	forvalues i = 1 / `num_searchvars' {
		local allvars = "`allvars' ``i''"
	}
	local allvars : list uniq allvars
	
	// Throw error if number of codesystems != searchvars
	if (`num_codesystems' != `num_searchvars') {
		
	}
	

	// Load the definition files for only the selected code systems, for code mapping 
	forvalues i = 1 / `num_codesystems' {
		display as text _newline "Loading iMPA code definitions for: {bf:" %9s "``i''" "}"
		
		if ("``i''" == "icd9cm") {
			quietly findfile "__icd9cm.ado"
			quietly include "`r(fn)'"
		} 
		else if ("``i''" == "icd9pcs") {
			quietly findfile "__icd9pcs.ado"
			quietly include "`r(fn)'"
		}
		else if ("``i''" == "icd10cm") {
			quietly findfile "__icd10cm.ado"
			quietly include "`r(fn)'"
		}
		else if ("``i''" == "icd10pcs") {
			quietly findfile "__icd10pcs.ado"
			quietly include "`r(fn)'"
		} 
		else if ("``i''" == "icd10") {
			quietly findfile "__icd10.ado"
			quietly include "`r(fn)'"
		}
		else if ("``i''" == "opcs4") {
			quietly findfile "__opcs4.ado"
			quietly include "`r(fn)'"
		}
		else if ("``i''" == "medcodeid") {
			quietly findfile "__medcodeid.ado"
			quietly include "`r(fn)'"
		}
		else {
			display as error "Error. Select one of the available code systems documented in the help file."
			error(3300)
			display as text "See: {stata help impa_helpfile: help impa}"
		}
				
		// Load selected coding system into associative array
		mata: impa_load("``i''", code_lookup)
		
	}
	


	// If '0' is specified as the number of CPU cores to use, use all available cores
	if (`n_cores' == 0) {
		local `n_cores' = `c(processors)'
		display _newline "Number of CPU cores not specified. iMPA will use all available CPU cores (`c(processors)' cores)."
	}
	
	// Run in either single or multi-CPU mode.
	if (`n_cores' == 1) {
		
		noisily display _newline "Ascertaining iMPA long-term conditions using a single CPU core..."
		
		// Load required data
		use `id' `allvars' using `dataset'
		
		// Create result variables and label these appropriately
		local n : word count `ltcs'
		tokenize "`ltcs'"

		// Create a local to store names of created variables
		local resultvars = ""
		
		forvalues i = 1 / `n' {
			quietly generate byte __``i'' = 0
			label variable __``i'' "`: word `i' of `ltc_labels''"
			local resultvars = "`resultvars' __``i''"
		}
		
		// Loop over each codesystem - searchvar pair and run search routine for each;
		// Therefore if four pairs submitted, run four separate searches
		forvalues i = 1 / `num_codesystems' {
			
			// Get unabbreviated list of all variables to search
			unab vars_to_search : ``i''
			
			// Loop over each variable that contains code data to be searched
			foreach var of varlist `vars_to_search' {
				findcodes `var' "`resultvars'" code_lookup
			}
		}
		
		// Keep only ID and result variables
		keep `id' `resultvars'
				
	} // end of single core processing code
	
	else {
		noisily display _newline "Ascertaining iMPA long-term conditions using `n_cores' CPU cores..."
		
		
		
	}
	
end

// Program to execute search function on nonmissing rows of data for each variable
capture program drop findcodes
program define findcodes
	args variable resultvars code_lookup
			
	// Mark observations that are nonmissing
	marksample touse, strok
	markout `touse' `variable', strok
			
	// Find conditions
	mata: impa_find("`variable'", "`touse'", "`resultvars'", code_lookup)
	
end


// Use codesystem-searchvar pairs to create multiple lookups (prevent clashes, etc)
// Ensure number of arguments to codesystems == number of arguments to searchvars
// adapt codefinder code to enable multi-CPU functionality.

