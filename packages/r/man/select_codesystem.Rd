\name{select_codesystem}
\alias{select_codesystem}
\title{Load an IMPACT code-system lookup}
\usage{select_codesystem(ontology)}
\arguments{\item{ontology}{A supported code-system name or alias.}}
\value{An environment mapping code strings to one or more granular LTC identifiers.}
\description{Returns the immutable IMPACT lookup captured for one coding system.}
